---
import Page from '../../layouts/Page.astro';
import { getJobs, jobUrl, entryDate, longDate, excerpt } from '../../lib/content';

const jobs = await getJobs();
const groups = [
  { tag: 'staff', title: 'Research staff positions' },
  { tag: 'master', title: "Master's theses" },
  { tag: 'bachelor', title: "Bachelor's theses" },
  { tag: 'student-assistant', title: 'Student assistant jobs' },
].map((g) => ({ ...g, jobs: jobs.filter((j) => j.data.tag === g.tag) })).filter((g) => g.jobs.length);
---
<Page title="Open Positions" lead="Join us as a researcher, write your thesis with us or work as a student assistant. Questions? Write to the contact listed in each posting.">
  {groups.map((g) => (
    <>
      <h2 class="group-title" id={g.tag}>{g.title}</h2>
      <ul class="entries no-thumb">
        {g.jobs.map((j) => (
          <li>
            <time datetime={entryDate(j).toISOString().slice(0, 10)}>{longDate(entryDate(j))}</time>
            <div>
              <h3><a href={jobUrl(j)}>{j.data.title}</a></h3>
              <p>{excerpt(j.body, 30).text}</p>
            </div>
          </li>
        ))}
      </ul>
    </>
  ))}
</Page>
