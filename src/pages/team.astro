---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import TeamMember from '../components/TeamMember.astro';

const team = (await getCollection('team')).sort((a, b) => a.id.localeCompare(b.id));
const groups = [
  { key: 'principals', title: 'Principals, Senior Researchers' },
  { key: 'phdstudents', title: 'Doctoral Candidates' },
  { key: 'students', title: 'Students' },
];
const hiring = "<a href='/open-positions/'>We are hiring!</a>";
---
<Page title="Team">
  {groups.map((g) => (
    <>
      <h2 class="mb-4">{g.title}</h2>
      <div class="row">
        {team.filter((m) => m.data.group === g.key).map((m) => (
          <TeamMember photo={m.data.photo} name={m.data.name} position={m.data.position} />
        ))}
        <TeamMember photo="question_mark.svg" name="You?" position={hiring} />
      </div>
    </>
  ))}
</Page>
