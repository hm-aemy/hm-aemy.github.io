---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import People from '../components/People.astro';

const team = (await getCollection('team')).sort((a, b) => a.id.localeCompare(b.id));
const groups = [
  { key: 'principals', title: 'Principals and senior researchers' },
  { key: 'phdstudents', title: 'Doctoral candidates' },
  { key: 'students', title: 'Students' },
];
---
<Page title="Team">
  {groups.map((g) => (
    <section class="section" style="padding-top:0">
      <h2 class="section-title">{g.title}</h2>
      <People members={team.filter((m) => m.data.group === g.key)} />
    </section>
  ))}
</Page>
