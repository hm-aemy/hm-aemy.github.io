---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import ProjectTable from '../components/ProjectTable.astro';
import People from '../components/People.astro';
import { getPosts, getJobs, getTopics, getProjects, entryDate, postUrl, jobUrl, postImage, longDate } from '../lib/content';

const posts = await getPosts();
const jobs = await getJobs();
const topics = await getTopics();
const { active } = await getProjects();
const principals = (await getCollection('team')).filter((m) => m.data.group === 'principals' && m.data.status === 'current').sort((a, b) => a.id.localeCompare(b.id));

const postHref = (p: (typeof posts)[number]) =>
  p.data.layout === 'cross-post' && p.data.external_url ? p.data.external_url : postUrl(p);

// Latest updates: posts, cross-posts and jobs, by `updated` or date
const latest = [
  ...posts.map((p) => ({ kind: 'News', title: p.data.title, href: postHref(p), date: p.data.updated ?? entryDate(p) })),
  ...jobs.map((j) => ({ kind: 'Job', title: j.data.title, href: jobUrl(j), date: j.data.updated ?? entryDate(j) })),
].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 4);

const news = posts.slice(0, 4);
---
<Base description="AEMY is the computer architecture group at Hochschule München University of Applied Sciences. We build open source chip design tools, from RISC-V extensions to simulation and formal verification, and train the people who use them.">
  <section class="wrap intro">
    <h1>Open source chip design tools that people actually use.</h1>
    <div>
      <p>We are <strong>s<u>A</u>fe s<u>E</u>cure and s<u>M</u>art s<u>Y</u>stems (AEMY)</strong>, the computer architecture
      group at Hochschule München University of Applied Sciences. We develop open source tools for chip design, from RISC-V
      instruction set extensions and hardware description languages to simulation and formal verification, and contribute
      them upstream to projects like Verilator, CIRCT, LibreLane and Surfer, so they stay maintained. In our teaching and
      tape-out programmes, students take a design from their first line of HDL to real silicon.</p>
      <div class="latest">
        <h2>Latest</h2>
        <ul>
          {latest.map((i) => (
            <li><time datetime={i.date.toISOString().slice(0, 10)}>{longDate(i.date)}</time><a href={i.href}>{i.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Research topics</h2>
    <ol class="topics">
      {topics.map((t, n) => (
        <li>
          <span class="num">0{n + 1}</span>
          <span class={`sq c-${t.data.color}`}></span>
          <div><h3><a href={`/topics/${t.id}`}>{t.data.label}</a></h3><p>{t.data.summary}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="band">
    <div class="wrap section">
      <h2 class="section-title">Projects</h2>
      <ProjectTable projects={active} />
      <a class="more" href="/projects">All current and previous projects →</a>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">News</h2>
    <div class="cards">
      {news.map((p) => (
        <NewsCard href={postHref(p)} title={p.data.title} date={entryDate(p)}
          kind={p.data.layout === 'cross-post' ? (p.data.source ?? 'Cross-post') : 'News'} image={postImage(p)} />
      ))}
    </div>
    <a class="more" href="/posts">All news →</a>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Team</h2>
    <People members={principals} />
    <a class="more" href="/team">The whole team →</a>
  </section>

  <section class="band">
    <div class="wrap section">
      <h2 class="section-title">Work with us</h2>
      <p class="statement">Europe's ability to design its own chips depends on open, reusable tools and on people trained to use them. We work on both.</p>
      <ul class="audiences">
        <li><h3>Partners and funders</h3><p>We lead work packages and deliver tools that are used and merged upstream.</p><a href="/projects">Our projects →</a></li>
        <li><h3>PhD students and researchers</h3><p>Work on open source tools used worldwide, with tape-outs and international partners.</p><a href="/open-positions/">Open positions →</a></li>
        <li><h3>Industry and SMEs</h3><p>Access to open chip design and RISC-V know-how, and graduates trained on these tools.</p><a href="mailto:stefan.wallentowitz@hm.edu">Get in touch →</a></li>
        <li><h3>HM students</h3><p>Courses, theses and tape-outs: build your own chip during your studies.</p><a href="/theses">Thesis topics →</a></li>
      </ul>
    </div>
  </section>
</Base>
