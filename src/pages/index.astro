---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import ProjectTable from '../components/ProjectTable.astro';
import People from '../components/People.astro';
import { getPosts, getJobs, getTopics, getProjects, entryDate, postUrl, jobUrl, postImage, longDate } from '../lib/content';

const posts = await getPosts();
const jobs = await getJobs();
const topics = await getTopics();
const { active } = await getProjects();
const principals = (await getCollection('team')).filter((m) => m.data.group === 'principals' && m.data.status === 'current').sort((a, b) => a.id.localeCompare(b.id));

const postHref = (p: (typeof posts)[number]) =>
  p.data.layout === 'cross-post' && p.data.external_url ? p.data.external_url : postUrl(p);

// Latest updates: posts, cross-posts and jobs, by `updated` or date
const latest = [
  ...posts.map((p) => ({ kind: 'News', title: p.data.title, href: postHref(p), date: p.data.updated ?? entryDate(p) })),
  ...jobs.map((j) => ({ kind: 'Job', title: j.data.title, href: jobUrl(j), date: j.data.updated ?? entryDate(j) })),
].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 4);

const news = posts.slice(0, 4);
---
<Base description="AEMY is the research group for safe, secure and smart systems at Hochschule München University of Applied Sciences: RISC-V, open source chip design tools, WebAssembly and formal methods.">
  <section class="wrap intro">
    <h1>We build open, safe and secure computer systems.</h1>
    <div>
      <p>We are the research group for <strong>s<u>A</u>fe s<u>E</u>cure and s<u>M</u>art s<u>Y</u>stems (AEMY)</strong>
      at Hochschule München University of Applied Sciences. Our research ranges from deeply embedded systems to large
      scale computer systems, and almost everything we build is open source.</p>
      <div class="latest">
        <h2>Latest</h2>
        <ul>
          {latest.map((i) => (
            <li><time datetime={i.date.toISOString().slice(0, 10)}>{longDate(i.date)}</time><a href={i.href}>{i.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Research topics</h2>
    <ol class="topics">
      {topics.map((t, n) => (
        <li>
          <span class="num">0{n + 1}</span>
          <span class={`sq c-${t.data.color}`}></span>
          <div><h3><a href={`/topics/${t.id}`}>{t.data.label}</a></h3><p>{t.data.summary}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="band">
    <div class="wrap section">
      <h2 class="section-title">Projects</h2>
      <ProjectTable projects={active} />
      <a class="more" href="/projects">All projects, including archived →</a>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">News</h2>
    <div class="cards">
      {news.map((p) => (
        <NewsCard href={postHref(p)} title={p.data.title} date={entryDate(p)}
          kind={p.data.layout === 'cross-post' ? (p.data.source ?? 'Cross-post') : 'News'} image={postImage(p)} />
      ))}
    </div>
    <a class="more" href="/posts">All news →</a>
  </section>

  <section class="wrap section">
    <h2 class="section-title">Team</h2>
    <People members={principals} />
    <a class="more" href="/team">The whole team →</a>
  </section>

  <section class="band">
    <div class="wrap section">
      <h2 class="section-title">All open source</h2>
      <div class="closing">
        <p class="statement">Our results and code should be available to everyone to extend and build commercial solutions around.</p>
        <div>
          <p>Want to work with our group, collaborate on a project or write your thesis with us? Get in touch.</p>
          <div class="actions">
            <a class="button" href="mailto:stefan.wallentowitz@hm.edu">Get in touch</a>
            <a class="button secondary" href="/open-positions/">Open positions</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
