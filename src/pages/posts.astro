---
import Page from '../layouts/Page.astro';
import { getPosts, entryDate, postUrl, postImage, excerpt, longDate } from '../lib/content';

const posts = await getPosts();
---
<Page title="News" lead="Project updates, conference visits, tools and results from the AEMY group.">
  <ul class="entries">
    {posts.map((post) => {
      const d = post.data;
      const cross = d.layout === 'cross-post';
      const href = cross && d.external_url ? d.external_url : postUrl(post);
      const img = postImage(post);
      return (
        <li>
          <time datetime={entryDate(post).toISOString().slice(0, 10)}>{longDate(entryDate(post))}</time>
          <div>
            {cross && <span class="tag">{d.source}</span>}
            <h3><a href={href}>{d.title}</a></h3>
            {d.author && <span class="by">By {d.author}{d.updated && ` · Updated ${longDate(d.updated)}`}</span>}
            <p>{excerpt(post.body, 40).text}</p>
          </div>
          <div>{img && <img src={img} alt="" loading="lazy">}</div>
        </li>
      );
    })}
  </ul>
</Page>
