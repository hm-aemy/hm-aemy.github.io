---
import Page from '../layouts/Page.astro';
import ProjectTable from '../components/ProjectTable.astro';
import { getProjects } from '../lib/content';

const { active, completed } = await getProjects();
---
<Page title="Projects" lead="Our third-party funded research projects, with partners from academia and industry.">
  <ProjectTable projects={active} />
  {completed.length > 0 && (
    <>
      <h2 class="group-title spaced" id="completed">Completed projects</h2>
      <ProjectTable projects={completed} />
    </>
  )}
</Page>
