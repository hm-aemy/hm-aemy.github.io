---
interface Props { photo: string; name: string; position: string }
const { photo, name, position } = Astro.props;
---
<div class="col-sm-3 col-6 mb-4">
  <div class="row">
    <div class="col-md-12">
      <img src={`/assets/img/${photo}`} alt={`Photo of ${name}`} class="img-fluid rounded-circle" />
    </div>
    <div class="col-md-12 text-center">
      <div class="pt-2">
        <h5 class="mt-4 font-weight-medium mb-1">{name}</h5>
        <h6 class="subtitle" set:html={position} />
      </div>
    </div>
  </div>
</div>
