---
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  article?: { author?: string; published?: Date };
  // Markdown pages in src/pages pass their front matter here
  frontmatter?: { title: string; subtitle?: string; description?: string };
}
const fm = Astro.props.frontmatter;
const title = fm?.title ?? Astro.props.title;
const subtitle = fm?.subtitle ?? Astro.props.subtitle;
const description = fm?.description ?? Astro.props.description;
const { article } = Astro.props;
---
<Base title={title} description={description} article={article}>
  <header class="header-section">
    <div class="intro-header">
      <div class="container-md">
        <div class="row">
          <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
            <div class="page-heading">
              <h1>{title}</h1>
              {subtitle && (
                <>
                  <hr class="small">
                  <span class="page-subheading">{subtitle}</span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container-md">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <slot />
      </div>
    </div>
  </main>
</Base>
